# 用法：复制本文件为同目录下的 secrets.local.yaml，填入自己的值。
#
#   secrets.local.yaml 已被 .gitignore 忽略，不会提交、也不会打进 jar。
#   application.yaml 通过 spring.config.import 以 optional 方式加载它。
#
# key 名必须与 application.yaml 里的 ${...} 占位符一致。
# 也可以在 IDEA Run Configuration / 容器 / CI 里直接设置同名环境变量，
# 效果相同且优先级更高，适合部署场景。
#
# 生成随机 JWT 密钥：openssl rand -hex 32

DB_PASSWORD: your-local-mysql-password
JWT_SECRET: replace-with-a-random-string-of-at-least-32-bytes
