# 统一换行符：避免 Windows 提交把整个仓库标成改动
* text=auto eol=lf

# Windows 脚本必须是 CRLF，否则 cmd 解析异常
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf

# 二进制文件不做换行转换，也不参与文本 diff
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
